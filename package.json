{
  "name": "git-message-gen",
  "displayName": "git-message-gen",
  "description": "",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
  "commands": [
    {
      "command": "git-message-gen.generateCommit",
      "title": "Historian: Generate Message",
      "icon": "$(magic)"
    },
    {
      "command": "git-message-gen.generateREADME",
      "title": "Historian: Architect README",
      "icon": "$(book)"
    }
  ],
  "menus": {
    "scm/title": [
      {
        "command": "git-message-gen.generateCommit",
        "group": "navigation",
        "when": "scmProvider == git"
      },
      {
        "command": "git-message-gen.generateREADME",
        "group": "navigation",
        "when": "scmProvider == git"
      }
    ]
  }
},
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
